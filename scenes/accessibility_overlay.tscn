[node name="HelpBody" type="Label" parent="HelpBackdrop/Center/HelpPanel/VBox"]
layout_mode = 2
size_flags_vertical = 3
text = "• Menus — Setas, WASD ou Tab / Shift+Tab: navegar; Enter: confirmar; Esc: voltar.
• Labirinto — W ou ↑: avançar; A/D ou ←/→: virar; S ou ↓: meia-volta.
• Atalhos no jogo — E: Minimapa lateral; M: descrição completa; P: Fio de Ariadne (guia).
• H ou F1: abrir ou fechar esta ajuda a qualquer momento.
• Todos os comandos podem ser remapeados em Opções → Controles (inclusive durante o jogo).

Jogo por turnos sem limite de tempo: o monstro só se move quando você avança.
Nenhum dado pessoal é coletado; suas preferências ficam salvas apenas neste computador."
autowrap_mode = 3

